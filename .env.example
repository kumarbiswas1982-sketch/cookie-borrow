# Set these in Vercel > Project > Settings > Environment Variables
SESSION_SECRET=paste-a-long-random-string-here-at-least-32-characters
# Optional but recommended: a code needed once, to create the account
SETUP_CODE=choose-a-short-secret
# Optional: lets you reset the password with /api/reset
RESET_KEY=another-long-random-string
# The database variables are added for you when you connect Upstash Redis (KV_REST_API_URL / KV_REST_API_TOKEN, or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
